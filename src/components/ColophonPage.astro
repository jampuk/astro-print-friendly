---
import PageSection from "../components/PageSection.astro";
import PrintFooter from "../components/PrintFooter.astro";
import { getPaper } from "../data/paper";

interface Props {
  companyName?: string;
}

const { companyName = "Your Company" } = Astro.props;
const paper = getPaper();
---

<PageSection noPrint>
  <div class="absolute inset-0 flex flex-col justify-between" style="padding: 20mm;">
    <div>
      <div style="margin-bottom: 8mm;">
        <span style="font-family: 'Space Grotesk', sans-serif; font-size: 6pt; font-weight: 600; color: #0EA5E9; letter-spacing: 0.1em; text-transform: uppercase;">Reference</span>
        <h2 style="font-family: 'Bricolage Grotesque', 'Space Grotesk', sans-serif; font-weight: 700; font-size: 22pt; color: #0B132B; letter-spacing: -0.02em; margin-top: 2mm;">Colophon</h2>
      </div>

      <div style="margin-bottom: 8mm;">
        <h3 style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 10pt; color: #0B132B; margin-bottom: 3mm;">Typography</h3>
        <div class="flex" style="gap: 4mm;">
          <div class="rounded-lg" style="flex: 1; padding: 4mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 14pt; color: #0B132B; margin-bottom: 1mm;">Bricolage Grotesque</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7pt; color: #64748B;">Display and headlines</div>
          </div>
          <div class="rounded-lg" style="flex: 1; padding: 4mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14pt; color: #0B132B; margin-bottom: 1mm;">Space Grotesk</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7pt; color: #64748B;">Headings and labels</div>
          </div>
          <div class="rounded-lg" style="flex: 1; padding: 4mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Inter', sans-serif; font-weight: 400; font-size: 14pt; color: #0B132B; margin-bottom: 1mm;">Inter</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7pt; color: #64748B;">Body copy</div>
          </div>
          <div class="rounded-lg" style="flex: 1; padding: 4mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Fira Code', monospace; font-weight: 400; font-size: 14pt; color: #0B132B; margin-bottom: 1mm;">Fira Code</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7pt; color: #64748B;">Monospace and code</div>
          </div>
        </div>
      </div>

      <div style="margin-bottom: 8mm;">
        <h3 style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 10pt; color: #0B132B; margin-bottom: 3mm;">Color System</h3>
        <div class="flex" style="gap: 2mm;">
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #FAFAFC; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #FFFFFF; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #F1F5F9; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #E2E8F0; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #0B132B; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #475569; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #0EA5E9; border: 1px solid #E2E8F0;"></div>
          <div class="rounded-lg" style="flex: 1; height: 12mm; background: #F59E0B; border: 1px solid #E2E8F0;"></div>
        </div>
        <div class="flex" style="gap: 2mm; margin-top: 1.5mm;">
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#FAFAFC</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#FFFFFF</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#F1F5F9</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#E2E8F0</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#0B132B</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#475569</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#0EA5E9</span></div>
          <div class="text-center" style="flex: 1;"><span style="font-family: 'Fira Code', monospace; font-size: 5pt; color: #64748B;">#F59E0B</span></div>
        </div>
      </div>

      <div>
        <h3 style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 10pt; color: #0B132B; margin-bottom: 3mm;">Specifications</h3>
        <div class="flex" style="gap: 3mm;">
          <div class="rounded-lg" style="flex: 1; padding: 3mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 6pt; color: #64748B; margin-bottom: 1mm;">FORMAT</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7.5pt; color: #0B132B;">{paper.spec}</div>
          </div>
          <div class="rounded-lg" style="flex: 1; padding: 3mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 6pt; color: #64748B; margin-bottom: 1mm;">RESOLUTION</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7.5pt; color: #0B132B;">300 DPI minimum</div>
          </div>
          <div class="rounded-lg" style="flex: 1; padding: 3mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 6pt; color: #64748B; margin-bottom: 1mm;">COLOR</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7.5pt; color: #0B132B;">CMYK adapted</div>
          </div>
          <div class="rounded-lg" style="flex: 1; padding: 3mm; border: 1px solid #E2E8F0;">
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 6pt; color: #64748B; margin-bottom: 1mm;">MARGINS</div>
            <div style="font-family: 'Inter', sans-serif; font-size: 7.5pt; color: #0B132B;">{paper.marginMm}mm safe area</div>
          </div>
        </div>
      </div>
    </div>

    <PrintFooter showPageNumber={false} companyName={companyName} />
  </div>
</PageSection>
